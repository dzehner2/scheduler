# Copy to .env.local for local development. See SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string (32+ characters). Generate one with: openssl rand -base64 48
APP_SECRET=
# The Google account(s) allowed to manage the scheduler, comma separated
OWNER_EMAIL=
# Postgres connection string
DATABASE_URL=postgres://localhost:5432/scheduler
# Public URL of the app, no trailing slash
APP_URL=http://localhost:3000
